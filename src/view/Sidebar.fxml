<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.SidebarController"
      stylesheets="@style.css"
      prefWidth="200"
      alignment="TOP_LEFT"
      spacing="15"
      style="-fx-background-color: #2c3e50;">
      
	<Label fx:id="label" text="Hello," styleClass="sidebar-text"/>
	
    <Button text="Home Page" onAction="#handleHome" styleClass="sidebar-button"/>
    <Button text="Tasks" onAction="#handleTasks" styleClass="sidebar-button"/>
    <Button text="Employees" onAction="#handleEmployees" styleClass="sidebar-button"/>
    
    <Separator style="-fx-background-color: #34495e;"/>
    
    <Button text="Add Employee" onAction="#addEmployee" styleClass="sidebar-button"/>
	<Button text="Add Task" onAction="#addTask" styleClass="sidebar-button"/>
    
    <Region VBox.vgrow="ALWAYS" />
    
    <Button text="Settings" onAction="#addTask" styleClass="sidebar-button"/>
    <Button text="Logout" onAction="#addEmployee" styleClass="sidebar-button"/>

</VBox>
