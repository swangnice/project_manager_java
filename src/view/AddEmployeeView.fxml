<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AddEmployeeViewController"
            stylesheets="@style.css">
    <left>
		<VBox fx:id="sidebar"/>
	</left>

	<center>
	    <StackPane fx:id="contentPane" alignment="CENTER" style="-fx-background-color: #ecf0f1;">
	        <GridPane hgap="10" vgap="10">
	            <padding>
	                <Insets top="20" right="20" bottom="20" left="20"/>
	            </padding>
	
	            <Label text="Add New Employee"
	                   style="-fx-font-size: 18px; -fx-font-weight: bold;"
	                   GridPane.columnSpan="2"
	                   GridPane.rowIndex="0"
	                   GridPane.columnIndex="0"/>
	
	            <Label text="First Name*:"    GridPane.rowIndex="1" GridPane.columnIndex="0"/>
	            <TextField fx:id="firstNameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
	
	            <Label text="Last Name:"     GridPane.rowIndex="2" GridPane.columnIndex="0"/>
	            <TextField fx:id="lastNameField"  GridPane.rowIndex="2" GridPane.columnIndex="1"/>
	
	            <Label text="Username*:"      GridPane.rowIndex="3" GridPane.columnIndex="0"/>
	            <TextField fx:id="usernameField"  GridPane.rowIndex="3" GridPane.columnIndex="1"/>
	
	            <Label text="Position:"      GridPane.rowIndex="4" GridPane.columnIndex="0"/>
	            <TextField fx:id="positionField"  GridPane.rowIndex="4" GridPane.columnIndex="1"/>
	
	            <Label text="Email:"         GridPane.rowIndex="5" GridPane.columnIndex="0"/>
	            <TextField fx:id="emailField"     GridPane.rowIndex="5" GridPane.columnIndex="1"/>
	
	            <Label text="Phone Number:"  GridPane.rowIndex="6" GridPane.columnIndex="0"/>
	            <TextField fx:id="phoneField"     GridPane.rowIndex="6" GridPane.columnIndex="1"/>
	
	            <!-- Added Password field -->
	            <Label text="Password*:"      GridPane.rowIndex="7" GridPane.columnIndex="0"/>
	            <PasswordField fx:id="passwordField1" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
	            <Label text="Repeat Password*:"      GridPane.rowIndex="8" GridPane.columnIndex="0"/>
	            <PasswordField fx:id="passwordField2" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
	
	            <Label fx:id="label"
	                   text="Type in Employees' Info"
	                   GridPane.rowIndex="10"
	                   GridPane.columnIndex="0"/>
	
	            <Button text="Submit"
	                    onAction="#handleSubmit"
	                    styleClass="submit-button"
	                    GridPane.rowIndex="9"
	                    GridPane.columnIndex="0"/>
	
	            <Button text="Reset"
	                    onAction="#handleReset"
	                    styleClass="reset-button"
	                    GridPane.rowIndex="9"
	                    GridPane.columnIndex="1"/>
	        </GridPane>
	    </StackPane>
	</center>

</BorderPane>